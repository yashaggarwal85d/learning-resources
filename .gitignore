
# Voice audition renders (the chosen voice is frozen in narration/pc/reference.wav)
site/narration/pc/audition/

# Rust topics that drive their examples through a small cargo crate (needs an external crate
# examples.py cannot prove with a bare rustc compile) build their own target/ dir; never commit it.
site/src/topics/rust-systems-engineering/**/examples/target/
site/src/topics/rust-systems-engineering/**/examples/*/target/

# dbt-core lab projects (data-engineering ch03) build target/, logs/ and dbt_packages/ when run;
# never commit those build artifacts.
site/src/topics/data-engineering/**/lab/*/target/
site/src/topics/data-engineering/**/lab/*/logs/
site/src/topics/data-engineering/**/lab/*/dbt_packages/
site/src/topics/data-engineering/**/lab/*/.user.yml
