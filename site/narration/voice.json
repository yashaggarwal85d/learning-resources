{
  "version": "tara-v1",
  "note": "The frozen narrator voice (PROJECT_PLAN.md, Narration). Changing anything here is a deliberate decision that regenerates every clip.",
  "model": {
    "name": "Orpheus 3B 0.1 (fine-tuned), Q4_K_M GGUF",
    "repo": "isaiahbjork/orpheus-3b-0.1-ft-Q4_K_M-GGUF",
    "base": "canopylabs/orpheus-3b-0.1-ft",
    "licence": "Apache-2.0 model card; built on Llama 3.2 (Built with Llama)"
  },
  "voice": "tara",
  "sampling": {
    "top_p": 0.95,
    "top_k": 50,
    "min_p": 0.05,
    "repeat_penalty": 1.1,
    "max_tokens": 2048,
    "n_ctx": 4096
  },
  "takes": [
    {
      "temperature": 0.7,
      "seed": 11
    },
    {
      "temperature": 0.78,
      "seed": 23
    },
    {
      "temperature": 0.85,
