---
// The full-screen reels feed. Used by /reels/ and by every topic's own address.
import Base from './Base.astro';
import ReelFeed from '../reels/ReelFeed.tsx';
import { liveData } from '../lib/live';

interface Props { domain?: string; topicId?: string; title: string; description: string }
const { domain, topicId, title, description } = Astro.props;
const live = liveData();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const initialDomain = domain ?? live.feedDomains.find((d) => d.live)?.id ?? live.feedDomains[0].id;

// Each topic's four panel tabs are rendered here, hidden, and copied into the right-hand panel when opened:
// Prerequisites (links), Pre-notes, Post-notes and Sources (Markdown files next to the reel).
const prereq = import.meta.glob<{ Content: any }>('../topics/**/prerequisites.mdx', { eager: true });
const pre = import.meta.glob<{ Content: any }>('../topics/**/pre-notes.md', { eager: true });
const post = import.meta.glob<{ Content: any }>('../topics/**/post-notes.md', { eager: true });
const sources = import.meta.glob<{ Content: any }>('../topics/**/references.md', { eager: true });
const pick = (g: Record<string, { Content: any }>, slug: string, file: string) => g[`../topics/${slug}/${file}`]?.Content;
---
<Base title={title} description={description}>
  <ReelFeed
    client:load
    base={base}
    domains={live.feedDomains}
    topics={live.ordered}
    initialDomain={initialDomain}
    initialTopic={topicId}
    nextAfter={live.nextAfter}
    upcoming={live.upcoming}
    tree={live.tree}
    comingTotal={live.comingTotal}
  />
  <div hidden>
    {live.ordered.map((t) => {
      const Prereq = pick(prereq, t.slug, 'prerequisites.mdx');
      const Pre = pick(pre, t.slug, 'pre-notes.md');
      const Post = pick(post, t.slug, 'post-notes.md');
      const Sources = pick(sources, t.slug, 'references.md');
      return (
        <>
          <article id={`prereq-${t.id}`} hidden>
            <p class="eyebrow text-[0.62rem] text-latte">Before you watch: where to learn it</p>
            {Prereq ? <Prereq host={t.id} /> : <p>This topic has no prerequisites beyond the ones before it in the curriculum.</p>}
          </article>
          <article id={`pre-${t.id}`} hidden>
            <p class="eyebrow text-[0.62rem] text-latte">Before you watch: what to know</p>
            {Pre ? <Pre /> : <p>Pre-notes coming soon.</p>}
          </article>
          <article id={`post-${t.id}`} hidden>
            <p class="eyebrow text-[0.62rem] text-latte">After you watch: going deeper</p>
            {Post ? <Post /> : <p>Post-notes coming soon.</p>}
          </article>
          <article id={`sources-${t.id}`} hidden>
            <p class="eyebrow text-[0.62rem] text-latte">What this topic rests on</p>
            {Sources ? <Sources /> : <p>No sources listed.</p>}
          </article>
        </>
      );
    })}
  </div>
  <noscript>
    <p class="p-6 text-latte">Reels need JavaScript to play.</p>
  </noscript>
</Base>
