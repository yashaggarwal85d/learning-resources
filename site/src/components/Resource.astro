---
// One resource in a topic's Prerequisites panel. A `reel` names a syllabus
// topic on this site: it links once that reel is live, and says so until then.
import { liveData } from '../lib/live';

interface Props {
  kind: 'video' | 'reading' | 'course' | 'reel';
  title: string;
  href?: string;
  by?: string;
  length?: string;
  domain?: string; // for reels
}
const { kind, title, href, by, length, domain } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const reel = kind === 'reel' && domain ? liveData().liveFor(domain, title) : undefined;
if (kind === 'reel' && domain && !liveData().domains.find((d) => d.id === domain)?.milestones.some((m) => m.chapters.some((c) => c.topics.some((t) => t.title === title))))
  throw new Error(`Resource: "${title}" is not a topic in syllabus/${domain}.md`);
const link = reel ? `${base}${reel.slug}/` : href;
const label = { video: 'Video', reading: 'Read', course: 'Course', reel: reel ? '▶ Reel' : 'Reel · soon' }[kind];
const external = !!link && link.startsWith('http');
---
<li class="res">
  <span class={`res-kind res-${kind}${reel ? ' res-live' : ''}`}>{label}</span>
  <span class="res-body">
    {link ? (
      <a href={link} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{reel?.title ?? title}</a>
    ) : (
      <span class="res-title">{title}</span>
    )}
    <span class="res-meta">{[by, length].filter(Boolean).join(' · ')}</span>
    <span class="res-note"><slot /></span>
  </span>
</li>
