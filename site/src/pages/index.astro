---
import Base from '../layouts/Base.astro';
import HeroSurface from '../components/HeroSurface.tsx';
import DomainArt from '../components/DomainArt.tsx';
import CurriculumMap from '../components/CurriculumMap.tsx';
import ReelAnatomy from '../components/ReelAnatomy.tsx';
import Counter from '../components/Counter.tsx';
import Mark from '../components/Mark.tsx';
import { loadDomains } from '../lib/syllabus';
import { liveData } from '../lib/live';

const domains = loadDomains();
const live = liveData();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const reelHref = (slug: string) => `${base}${slug}/`;
const liveCount = (id: string) => live.ordered.filter((t) => t.domain === id).length;
const firstReel = live.ordered[0];
const liveMap = Object.fromEntries(
  domains.map((d) => [d.id, Object.fromEntries(live.ordered.filter((t) => t.domain === d.id).map((t) => [t.syllabusTitle, reelHref(t.slug)]))]),
);
const total = domains.reduce(
  (a, d) => ({
    milestones: a.milestones + d.counts.milestones,
    chapters: a.chapters + d.counts.chapters,
    topics: a.topics + d.counts.topics,
    labs: a.labs + d.counts.labs,
  }),
  { milestones: 0, chapters: 0, topics: 0, labs: 0 },
);
const words = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six'];
const fields = words[domains.length] ?? String(domains.length);
const promises = [
  { k: 'Animated where it explains', v: 'Every process you can watch, you can also drive: change a parameter and see the system respond. Motion never just decorates.' },
  { k: 'Verified, not vibes', v: 'Primary sources for every claim, every example executed in CI, adversarial review, and a human expert sign-off per milestone.' },
  { k: 'Built for experts', v: 'Hard problem first, mechanism in full, depth on demand. Skip what you already know; nothing is dumbed down.' },
  { k: 'One topic at a time', v: 'Each topic is finished, polished and verified before the next one starts. Quality is never traded for coverage.' },
];
const today = new Date().toISOString().slice(0, 10);
---
<Base
  title="The Learning Experience"
  description="Animated, interactive deep-dives into data engineering, Rust systems engineering, and data structures & algorithms. Built for experts, verified against primary sources."
>
  <header class="fixed inset-x-0 top-0 z-40 border-b border-transparent transition-colors duration-500" id="topbar">
    <nav class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3.5 sm:px-6" aria-label="Main">
      <a href="#top" class="flex items-center gap-2.5 text-chalk">
        <Mark size={24} />
        <span class="whitespace-nowrap font-display text-[0.98rem] tracking-[-0.01em] sm:text-[1.05rem]">The Learning Experience</span>
      </a>
      <div class="flex items-center gap-1">
        <a href="#domains" class="hidden rounded-md px-3 py-1.5 font-mono text-[0.66rem] uppercase tracking-[0.18em] text-latte transition hover:text-chalk md:block">Domains</a>
        <a href="#how" class="hidden rounded-md px-3 py-1.5 font-mono text-[0.66rem] uppercase tracking-[0.18em] text-latte transition hover:text-chalk md:block">How it teaches</a>
        <a href="#curriculum" class="hidden rounded-md px-3 py-1.5 font-mono text-[0.66rem] uppercase tracking-[0.18em] text-latte transition hover:text-chalk md:block">Curriculum</a>
        <a href={`${base}reels/`} class="ml-2 inline-flex items-center gap-2 rounded-full bg-chalk px-4 py-1.5 text-sm font-semibold text-espresso transition hover:bg-white">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
          Reels
          <span class="hidden whitespace-nowrap rounded-full bg-espresso/10 px-1.5 font-mono text-[0.6rem] uppercase tracking-wider sm:inline">{live.ordered.length} live</span>
        </a>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- Hero: the briefing -->
    <section class="grain reel-bg relative isolate overflow-hidden">
      <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-6 px-4 pb-14 pt-28 sm:px-6 md:min-h-[92svh] md:grid-cols-[1fr_1.05fr] md:pb-20 md:pt-24">
        <div>
          <p class="hero-in eyebrow text-latte" style="--d:0.1s">Briefing · {today} · {domains.length} domains · {total.topics.toLocaleString('en-US')} topics</p>
          <h1 class="mt-6 font-display font-[300] leading-[0.98] tracking-[-0.02em] text-chalk text-[clamp(2.9rem,7vw,5.9rem)]">
            <span class="line"><span style="--d:0.2s">The hardest things,</span></span>
            <span class="line"><span class="italic text-brew" style="--d:0.34s">made clear.</span></span>
          </h1>
          <p class="hero-in mt-7 max-w-xl text-lg leading-relaxed text-crema" style="--d:0.55s">
            Animated, narrated deep-dives for people who are already very good, and want to understand how things really work. Every claim checked against its primary source.
          </p>
          <div class="hero-in mt-9 flex flex-wrap gap-3" style="--d:0.7s">
            <a href={firstReel ? reelHref(firstReel.slug) : `${base}reels/`} class="group inline-flex items-center gap-3 rounded-full bg-chalk py-2 pl-2 pr-6 font-semibold text-espresso transition hover:bg-white">
              <span class="grid h-8 w-8 place-items-center rounded-full bg-espresso text-chalk transition duration-300 group-hover:scale-110">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
              </span>
              Start watching
            </a>
            <a href="#domains" class="group inline-flex items-center gap-2 rounded-full border border-crema/25 px-6 py-3 font-medium text-crema transition hover:border-crema/60 hover:text-chalk">
              Explore the domains
              <span class="transition duration-300 group-hover:translate-x-1">→</span>
            </a>
          </div>
          <dl class="hero-in mt-12 grid max-w-lg grid-cols-3 border-t border-line pt-5" style="--d:0.85s">
            <div><dt class="eyebrow text-[0.58rem] text-taupe">Reels live</dt><dd class="mt-1 font-display text-3xl font-[300] tabular-nums text-chalk">{live.ordered.length}</dd></div>
            <div class="border-l border-line pl-5"><dt class="eyebrow text-[0.58rem] text-taupe">Chapters</dt><dd class="mt-1 font-display text-3xl font-[300] tabular-nums text-chalk">{total.chapters}</dd></div>
            <div class="border-l border-line pl-5"><dt class="eyebrow text-[0.58rem] text-taupe">Topics</dt><dd class="mt-1 font-display text-3xl font-[300] tabular-nums text-chalk">{total.topics.toLocaleString('en-US')}</dd></div>
          </dl>
        </div>
        <figure class="hero-in relative mx-auto aspect-square w-full max-w-[560px]" style="--d:0.3s" aria-label="A wireframe saddle surface, z equals x squared minus y squared, turning slowly, its saddle point marked in red">
          <div class="ticks pointer-events-none absolute inset-0" aria-hidden="true"></div>
          <HeroSurface client:load />
          <figcaption class="pointer-events-none absolute inset-x-4 top-3 flex items-start justify-between font-mono text-[0.58rem] uppercase tracking-[0.2em] text-taupe">
            <span>Fig 00 · hyperbolic paraboloid</span>
            <span class="font-display text-[1.25rem] normal-case italic tracking-normal text-crema">z = x² − y²</span>
          </figcaption>
          <p class="pointer-events-none absolute bottom-3 left-4 font-mono text-[0.58rem] uppercase tracking-[0.2em] text-taupe"><span class="text-signal">●</span> saddle point (0, 0, 0)</p>
        </figure>
      </div>
    </section>

    <!-- Numbers -->
    <section class="border-y border-line bg-panel/60">
      <div class="mx-auto grid max-w-6xl grid-cols-2 gap-y-8 px-4 py-12 sm:grid-cols-5 sm:px-6" data-reveal>
        <div class="sm:pr-6"><Counter client:visible value={domains.length} label="Domains" /></div>
        <div class="border-line sm:border-l sm:pl-6"><Counter client:visible value={total.milestones} label="Milestones" /></div>
        <div class="border-line sm:border-l sm:pl-6"><Counter client:visible value={total.chapters} label="Chapters" /></div>
        <div class="border-line sm:border-l sm:pl-6"><Counter client:visible value={total.topics} label="Topics" /></div>
        <div class="border-line sm:border-l sm:pl-6"><Counter client:visible value={total.labs} label="Labs" /></div>
      </div>
    </section>

    <!-- Domains -->
    <section id="domains" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24 sm:px-6">
      <div class="grid gap-6 md:grid-cols-[1fr_1fr] md:items-end" data-reveal>
        <div>
          <p class="eyebrow text-taupe">01 · The domains</p>
          <h2 class="mt-3 max-w-3xl font-display text-4xl font-[300] leading-[1.05] tracking-[-0.015em] text-chalk sm:text-6xl">
            {fields} fields, taught from the <span class="italic text-latte">mechanism</span> up.
          </h2>
        </div>
        <p class="max-w-md text-crema md:justify-self-end">Each domain is a full curriculum, released one verified topic at a time. Open one to start at its first reel.</p>
      </div>
      <div class="mt-14 grid gap-5 lg:grid-cols-3">
        {domains.map((d, i) => (
          <a
            href={liveCount(d.id) ? reelHref(live.ordered.find((t) => t.domain === d.id)!.slug) : '#curriculum'}
            data-reveal
            style={`--d:${i * 0.08}s`}
            class="domain-card group relative overflow-hidden rounded-lg border border-line bg-panel/60 p-5 transition duration-500 hover:border-crema/30 sm:p-6"
          >
            <div class="ticks relative aspect-[16/9] overflow-hidden rounded-md border border-line bg-espresso/80">
              <DomainArt client:visible id={d.id} />
            </div>
            <div class="mt-6 flex items-start justify-between gap-4">
              <div>
                <p class="eyebrow text-[0.62rem] text-taupe">File {String(i + 1).padStart(2, '0')} · {d.counts.topics} topics</p>
                <h3 class="mt-2 font-display text-[1.75rem] font-[350] leading-tight text-chalk">{d.title}</h3>
              </div>
              <span class="mt-2 grid h-10 w-10 shrink-0 place-items-center rounded-full border border-crema/20 text-crema transition duration-500 group-hover:-rotate-45 group-hover:border-chalk group-hover:bg-chalk group-hover:text-espresso">→</span>
            </div>
            <p class="mt-3 text-[0.98rem] leading-relaxed text-crema">{d.tagline}</p>
            <div class="mt-5 flex flex-wrap gap-2 font-mono text-[0.64rem] uppercase tracking-[0.16em] text-latte">
              <span class="rounded-md border border-line px-2.5 py-1">{d.counts.milestones} milestones</span>
              <span class="rounded-md border border-line px-2.5 py-1">{d.counts.chapters} chapters</span>
              {liveCount(d.id) ? (
                <span class="rounded-md bg-chalk px-2.5 py-1 font-semibold text-espresso">▶ {liveCount(d.id)} {liveCount(d.id) === 1 ? 'reel' : 'reels'} live</span>
              ) : (
                <span class="rounded-md border border-dashed border-line px-2.5 py-1 text-taupe">Reels soon</span>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- How every topic teaches -->
    <section id="how" class="grain relative scroll-mt-20 overflow-hidden border-y border-line bg-void py-24">
      <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
        <div class="text-center" data-reveal>
          <p class="eyebrow text-taupe">02 · Anatomy of a reel</p>
          <h2 class="mx-auto mt-3 max-w-3xl font-display text-4xl font-[300] leading-[1.05] tracking-[-0.015em] text-chalk sm:text-6xl">
            Every topic is a reel that <span class="italic text-latte">waits for you.</span>
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg text-crema">
            Ten layers, from the hard problem to the frontier. Fully animated, narrated, and paced by you: it waits whenever there is something to think about.
          </p>
        </div>
        <div class="mt-14" data-reveal>
          <ReelAnatomy client:visible />
        </div>
      </div>
    </section>

    <!-- Promises -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <p class="eyebrow text-taupe" data-reveal>03 · The standard</p>
      <div class="mt-8 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-4">
        {promises.map((p, i) => (
          <div data-reveal style={`--d:${i * 0.08}s`} class="border-b border-r border-line p-6 transition-colors duration-500 hover:bg-panel/70">
            <div class="font-mono text-[0.7rem] tracking-[0.2em] text-taupe">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="mt-8 font-display text-[1.4rem] font-[400] leading-snug text-chalk">{p.k}</h3>
            <p class="mt-2 text-sm leading-relaxed text-latte">{p.v}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Curriculum map -->
    <section id="curriculum" class="scroll-mt-20 border-t border-line bg-panel/40 py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div data-reveal>
          <p class="eyebrow text-taupe">04 · The curriculum</p>
          <h2 class="mt-3 max-w-3xl font-display text-4xl font-[300] leading-[1.05] tracking-[-0.015em] text-chalk sm:text-6xl">
            Domains → milestones → chapters → <span class="italic text-latte">topics.</span>
          </h2>
          <p class="mt-5 max-w-2xl text-lg text-crema">
            The full map, generated from the syllabus itself. Open a milestone, then a chapter, to see every topic. Topics go live one at a time, as each is finished and verified.
          </p>
        </div>
        <div class="mt-12" data-reveal>
          <CurriculumMap client:visible domains={domains} live={liveMap} />
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line px-4 py-12 sm:px-6">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <p class="flex items-center gap-3 font-display text-lg italic text-crema"><Mark size={20} /> One topic at a time. Verified against primary sources.</p>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-taupe">© {new Date().getFullYear()} The Learning Experience</p>
    </div>
  </footer>

  <script>
    // The top bar gains a hairline and a backdrop once the page scrolls.
    const bar = document.getElementById('topbar');
    const onScroll = () => bar?.classList.toggle('scrolled', window.scrollY > 24);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  </script>
</Base>

<style is:global>
  #topbar.scrolled { border-color: var(--color-line); background: color-mix(in oklab, var(--color-espresso) 82%, transparent); backdrop-filter: blur(14px); }
  .hero-in {
    opacity: 0;
    transform: translateY(18px);
    animation: hero-in 1.1s var(--ease-brief) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes hero-in {
    to { opacity: 1; transform: none; }
  }
  /* Headline lines rise out of a mask. */
  h1 .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  h1 .line > span { display: inline-block; transform: translateY(105%); animation: line-in 1.1s var(--ease-brief) forwards; animation-delay: var(--d, 0s); }
  @keyframes line-in { to { transform: none; } }
  [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 0.9s var(--ease-brief) var(--d, 0s), transform 0.9s var(--ease-brief) var(--d, 0s);
  }
  [data-reveal].in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .hero-in, [data-reveal], h1 .line > span { opacity: 1 !important; transform: none !important; animation: none !important; }
  }
</style>
