---
import Base from '../layouts/Base.astro';
import Constellation from '../components/Constellation.tsx';
import DomainArt from '../components/DomainArt.tsx';
import CurriculumMap from '../components/CurriculumMap.tsx';
import ReelAnatomy from '../components/ReelAnatomy.tsx';
import Counter from '../components/Counter.tsx';
import { loadDomains } from '../lib/syllabus';
import { liveData } from '../lib/live';

const domains = loadDomains();
const live = liveData();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const reelHref = (slug: string) => `${base}${slug}/`;
const liveCount = (id: string) => live.ordered.filter((t) => t.domain === id).length;
const firstReel = live.ordered[0];
const liveMap = Object.fromEntries(
  domains.map((d) => [d.id, Object.fromEntries(live.ordered.filter((t) => t.domain === d.id).map((t) => [t.syllabusTitle, reelHref(t.slug)]))]),
);
const sky = domains.map((d) => ({
  id: d.id,
  title: d.title,
  topics: d.counts.topics,
  milestones: d.milestones.map((m) => m.chapters.map((c) => c.topics.length)),
  live: d.milestones.flatMap((m, mi) =>
    m.chapters.flatMap((c, ci) => c.topics.flatMap((tp, ti) => (live.liveFor(d.id, tp.title) ? [[mi, ci, ti] as [number, number, number]] : []))),
  ),
}));
const total = domains.reduce(
  (a, d) => ({
    milestones: a.milestones + d.counts.milestones,
    chapters: a.chapters + d.counts.chapters,
    topics: a.topics + d.counts.topics,
    labs: a.labs + d.counts.labs,
  }),
  { milestones: 0, chapters: 0, topics: 0, labs: 0 },
);
const promises = [
  { k: 'Animated where it explains', v: 'Every process you can watch, you can also drive: change a parameter and see the system respond. Motion never just decorates.' },
  { k: 'Verified, not vibes', v: 'Primary sources for every claim, every example executed in CI, adversarial review, and a human expert sign-off per milestone.' },
  { k: 'Built for experts', v: 'Hard problem first, mechanism in full, depth on demand. Skip what you already know; nothing is dumbed down.' },
  { k: 'One topic at a time', v: 'Each topic is finished, polished and verified before the next one starts. Quality is never traded for coverage.' },
];
---
<Base
  title="The Learning Experience"
  description="Animated, interactive deep-dives into data engineering, Rust systems engineering, data structures & algorithms, and German. Built for experts, verified against primary sources."
>
  <header class="fixed inset-x-0 top-0 z-40">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 pt-4 sm:px-6" aria-label="Main">
      <a href="#top" class="flex items-center gap-2.5 rounded-xl border border-crema/10 bg-espresso/85 px-3 py-2 backdrop-blur-xl">
        <span class="grid h-6 w-6 place-items-center rounded-md bg-caramel font-display text-sm font-bold italic text-espresso">L</span>
        <span class="font-display text-[0.95rem] font-semibold italic">The Learning Experience</span>
      </a>
      <div class="flex items-center gap-1 rounded-full border border-crema/10 bg-espresso/85 p-1.5 backdrop-blur-xl">
        <a href="#domains" class="hidden rounded-full px-4 py-1.5 text-sm text-latte transition hover:bg-crema/10 hover:text-crema md:block">Domains</a>
        <a href="#how" class="hidden rounded-full px-4 py-1.5 text-sm text-latte transition hover:bg-crema/10 hover:text-crema md:block">How it teaches</a>
        <a href="#curriculum" class="hidden rounded-full px-4 py-1.5 text-sm text-latte transition hover:bg-crema/10 hover:text-crema md:block">Curriculum</a>
        <a href={`${base}reels/`} class="group inline-flex items-center gap-2 rounded-full bg-caramel px-4 py-1.5 text-sm font-semibold text-espresso transition hover:brightness-110">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
          Reels
          <span class="whitespace-nowrap rounded-full bg-espresso/15 px-1.5 font-mono text-[0.62rem] uppercase tracking-wider">{live.ordered.length} live</span>
        </a>
      </div>
    </nav>
  </header>

  <main id="top">
    <!-- Hero: the whole curriculum as a night sky -->
    <section class="grain relative isolate h-[100svh] min-h-[640px] overflow-hidden bg-[radial-gradient(ellipse_at_70%_40%,#2a1d16_0%,#17100c_55%,#0d0806_100%)]">
      <Constellation client:load domains={sky} />
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-espresso/95 via-espresso/55 to-transparent max-md:bg-gradient-to-b max-md:from-espresso/90 max-md:via-espresso/40"></div>
      <div class="relative mx-auto flex h-full max-w-6xl flex-col justify-center px-4 sm:px-6 max-md:justify-start max-md:pt-28">
        <p class="hero-in eyebrow text-caramel" style="--d:0.1s">Four domains · {total.topics.toLocaleString('en-US')} topics · verified</p>
        <h1 class="mt-5 font-display font-bold leading-[0.92] tracking-[-0.02em] text-[clamp(3rem,8.5vw,7.4rem)]">
          <span class="hero-in block" style="--d:0.25s">The hardest things,</span>
          <span class="hero-in text-brew block italic" style="--d:0.45s">made clear.</span>
        </h1>
        <p class="hero-in mt-6 max-w-xl text-lg leading-relaxed text-latte sm:text-xl" style="--d:0.65s">
          Animated, interactive deep-dives for people who are already very good, and want to understand how things really work.
        </p>
        <div class="hero-in mt-9 flex flex-wrap gap-3" style="--d:0.85s">
          <a href={firstReel ? reelHref(firstReel.slug) : `${base}reels/`} class="group inline-flex items-center gap-2.5 rounded-full bg-caramel px-6 py-3 font-semibold text-espresso transition hover:brightness-110">
            <span class="grid h-6 w-6 place-items-center rounded-full bg-espresso text-caramel transition group-hover:scale-110">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
            </span>
            Start watching
          </a>
          <a href="#domains" class="group inline-flex items-center gap-2 rounded-full border border-crema/25 px-6 py-3 font-medium text-crema transition hover:border-crema/60">
            Explore the domains
            <span class="transition group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>
      <a href="#domains" class="hero-in absolute bottom-7 left-1/2 -translate-x-1/2 text-latte/70" style="--d:1.6s" aria-label="Scroll to the domains">
        <span class="scroll-cue block h-10 w-6 rounded-full border border-crema/30"><span class="mx-auto mt-2 block h-2 w-1 rounded-full bg-caramel"></span></span>
      </a>
    </section>

    <!-- Numbers -->
    <section class="border-y border-crema/8 bg-roast/40">
      <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-4 py-12 sm:grid-cols-5 sm:px-6" data-reveal>
        <Counter client:visible value={domains.length} label="Domains" />
        <Counter client:visible value={total.milestones} label="Milestones" />
        <Counter client:visible value={total.chapters} label="Chapters" />
        <Counter client:visible value={total.topics} label="Topics" />
        <Counter client:visible value={total.labs} label="Labs" />
      </div>
    </section>

    <!-- Domains -->
    <section id="domains" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-24 sm:px-6">
      <div data-reveal>
        <p class="eyebrow text-caramel">The domains</p>
        <h2 class="mt-3 max-w-3xl font-display text-4xl font-bold leading-[1.05] sm:text-6xl">
          Four fields, taught from the <span class="italic text-caramel">mechanism</span> up.
        </h2>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {domains.map((d, i) => (
          <a
            href={liveCount(d.id) ? reelHref(live.ordered.find((t) => t.domain === d.id)!.slug) : '#curriculum'}
            data-domain={d.id}
            data-reveal
            style={`--d:${i * 0.08}s`}
            class="domain-card group relative overflow-hidden rounded-[28px] border border-crema/10 bg-roast/70 p-6 transition duration-500 hover:-translate-y-1 hover:border-caramel/40 hover:shadow-[0_30px_80px_rgba(0,0,0,.5)] sm:p-7"
          >
            <div class="relative -mx-2 aspect-[16/9] overflow-hidden rounded-2xl bg-espresso/70">
              <DomainArt client:visible id={d.id} />
            </div>
            <div class="mt-6 flex items-start justify-between gap-4">
              <div>
                <p class="eyebrow text-caramel/90">Domain {String(i + 1).padStart(2, '0')}</p>
                <h3 class="mt-2 font-display text-3xl font-bold leading-tight text-crema">{d.title}</h3>
              </div>
              <span class="mt-2 grid h-10 w-10 shrink-0 place-items-center rounded-full border border-crema/20 text-crema transition group-hover:rotate-[-45deg] group-hover:border-caramel group-hover:bg-caramel group-hover:text-espresso">→</span>
            </div>
            <p class="mt-3 text-[0.98rem] leading-relaxed text-latte">{d.tagline}</p>
            <div class="mt-5 flex flex-wrap gap-2 font-mono text-[0.7rem] uppercase tracking-[0.16em] text-latte/90">
              <span class="rounded-full border border-crema/10 px-3 py-1">{d.counts.milestones} milestones</span>
              <span class="rounded-full border border-crema/10 px-3 py-1">{d.counts.chapters} chapters</span>
              <span class="rounded-full border border-crema/10 px-3 py-1">{d.counts.topics} topics</span>
              {liveCount(d.id) ? (
                <span class="rounded-full bg-caramel px-3 py-1 font-semibold text-espresso">▶ {liveCount(d.id)} {liveCount(d.id) === 1 ? 'reel' : 'reels'} live</span>
              ) : (
                <span class="rounded-full border border-dashed border-crema/15 px-3 py-1 text-latte/60">Reels soon</span>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- How every topic teaches -->
    <section id="how" class="grain relative scroll-mt-20 overflow-hidden bg-void py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="text-center" data-reveal>
          <p class="eyebrow text-caramel">Anatomy of a reel</p>
          <h2 class="mx-auto mt-3 max-w-3xl font-display text-4xl font-bold leading-[1.05] sm:text-6xl">
            Every topic is a reel that <span class="italic text-caramel">waits for you.</span>
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg text-latte">
            Ten layers, from the hard problem to the frontier. Fully animated and paced by you: it waits whenever there is something to think about.
          </p>
        </div>
        <div class="mt-14" data-reveal>
          <ReelAnatomy client:visible />
        </div>
      </div>
    </section>

    <!-- Promises -->
    <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {promises.map((p, i) => (
          <div data-reveal style={`--d:${i * 0.08}s`} class="rounded-[24px] border border-crema/10 bg-roast/50 p-6">
            <div class="font-display text-5xl font-bold italic text-caramel/80">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="mt-4 font-display text-xl font-semibold text-crema">{p.k}</h3>
            <p class="mt-2 text-sm leading-relaxed text-latte">{p.v}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Curriculum map -->
    <section id="curriculum" class="scroll-mt-20 border-t border-crema/8 bg-roast/30 py-24">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div data-reveal>
          <p class="eyebrow text-caramel">The curriculum</p>
          <h2 class="mt-3 max-w-3xl font-display text-4xl font-bold leading-[1.05] sm:text-6xl">
            Domains → milestones → chapters → <span class="italic text-caramel">topics.</span>
          </h2>
          <p class="mt-5 max-w-2xl text-lg text-latte">
            The full map, generated from the syllabus itself. Open a milestone, then a chapter, to see every topic. Topics go live one at a time, as each is finished and verified.
          </p>
        </div>
        <div class="mt-12" data-reveal>
          <CurriculumMap client:visible domains={domains} live={liveMap} />
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-crema/8 px-4 py-12 sm:px-6">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <p class="font-display text-lg italic text-crema">One topic at a time. Verified against primary sources.</p>
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-taupe">© {new Date().getFullYear()} The Learning Experience</p>
    </div>
  </footer>

  <script>
    // Hovering a domain card lights up its galaxy in the hero sky.
    document.querySelectorAll<HTMLElement>('[data-domain]').forEach((el) => {
      const send = (id: string | null) => window.dispatchEvent(new CustomEvent('constellation:focus', { detail: id }));
      el.addEventListener('mouseenter', () => send(el.dataset.domain ?? null));
      el.addEventListener('mouseleave', () => send(null));
    });
  </script>
</Base>

<style is:global>
  .hero-in {
    opacity: 0;
    transform: translateY(26px);
    filter: blur(8px);
    animation: hero-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--d, 0s);
  }
  @keyframes hero-in {
    to { opacity: 1; transform: none; filter: blur(0); }
  }
  [data-reveal] {
    opacity: 0;
    transform: translateY(34px);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s), transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s);
  }
  [data-reveal].in { opacity: 1; transform: none; }
  .domain-card[data-reveal].in:hover { transform: translateY(-4px); }
  .scroll-cue span { animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue {
    0%, 100% { transform: translateY(0); opacity: 1; }
    60% { transform: translateY(12px); opacity: 0.2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-in, [data-reveal] { opacity: 1 !important; transform: none !important; filter: none !important; }
  }
</style>
