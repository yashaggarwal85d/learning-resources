   "takes": [
    "40261ae9b622e78a7754"
   ],
   "duration": 12.76,
   "lines": [
    {
     "text": "Run it for real: genuinely disruptive. Every node updates its own term the moment it sees a higher one, and the healthy leader genuinely steps down.",
     "start": 0.15,
     "end": 12.41
    }
   ],
   "lufs": -16.4,
   "true_peak": -1.9,
   "wpm": 122,
   "wer": 0.0,
   "exact": true,
   "tolerated": []
