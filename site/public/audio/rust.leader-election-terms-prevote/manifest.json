   ],
   "duration": 5.785,
   "lines": [
    {
     "text": "Yes, genuinely.",
     "start": 0.15,
     "end": 1.42
    },
    {
     "text": "Every node updates to a higher term it sees.",
     "start": 1.84,
     "end": 5.435
    }
