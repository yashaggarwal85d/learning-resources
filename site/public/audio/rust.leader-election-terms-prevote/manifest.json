   ],
   "duration": 11.38,
   "lines": [
    {
     "text": "Run it for real: the out-of-date candidate's own vote request is genuinely rejected, by the real up-to-date-log voting rule; it loses the election.",
     "start": 0.15,
     "end": 11.03
    }
   ],
   "lufs": -16.4,
   "true_peak": -1.9,
   "wpm": 148,
