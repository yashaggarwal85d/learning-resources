    "ead2ca86b1271d966730"
   ],
   "duration": 18.498,
   "lines": [
    {
     "text": "A healthy cluster has a live leader. One node gets partitioned and, missing every heartbeat, keeps incrementing its own term locally.",
     "start": 0.15,
     "end": 10.244
    },
    {
     "text": "When it rejoins and broadcasts that stale, inflated term, does the healthy leader genuinely step down?",
     "start": 10.964,
     "end": 18.148
    }
   ],
   "lufs": -16.6,
   "true_peak": -3.2,
   "wpm": 120,
