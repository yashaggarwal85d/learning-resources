   ],
   "duration": 4.026,
   "lines": [
    {
     "text": "Yes, genuinely.",
     "start": 0.15,
     "end": 1.42
    },
    {
     "text": "Its term never even rises.",
     "start": 1.84,
     "end": 3.676
