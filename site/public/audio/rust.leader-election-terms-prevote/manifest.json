   "takes": [
    "cabbd5558eef9b8258c0"
   ],
   "duration": 16.637,
   "lines": [
    {
     "text": "Run it for real: with that pre-vote round, every healthy voter already has a live leader and genuinely denies it; the partitioned node's own term never rises, and the healthy leader is never disturbed.",
     "start": 0.15,
     "end": 16.287
    }
   ],
   "lufs": -16.4,
   "true_peak": -2.0,
   "wpm": 126,
   "wer": 0.0,
   "exact": true,
