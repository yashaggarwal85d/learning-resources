   "duration": 13.014,
   "lines": [
    {
     "text": "Third. Defend a design.",
     "start": 0.15,
     "end": 2.124
    },
    {
     "text": "A point of three small numbers is passed by value in a loop, and the compiler complains on the second pass.",
     "start": 2.544,
     "end": 9.153
    },
    {
     "text": "Which fix fits this type best?",
