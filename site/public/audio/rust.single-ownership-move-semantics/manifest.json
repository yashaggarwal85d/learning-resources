   "takes": [
    "fcc8eaf3334982ff32ea",
    "7135f988ed79073b1753"
   ],
   "duration": 6.619,
   "lines": [
    {
     "text": "The shared borrow.",
     "start": 0.15,
     "end": 1.343
    },
    {
     "text": "The function only reads, so it shouldn't own the batch... or lock it.",
