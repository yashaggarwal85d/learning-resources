   ],
   "duration": 7.929,
   "lines": [
    {
     "text": "Three questions to prove it.",
     "start": 0.15,
     "end": 1.904
    },
    {
     "text": "First. Run without arguments, so retry is false.",
     "start": 2.324,
     "end": 5.887
    },
    {
     "text": "What happens?",
     "start": 6.707,
     "end": 7.579
    }
   ],
   "lufs": -16.6,
